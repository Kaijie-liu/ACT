+def _normalize_hz_status(status_str: str) -> str:
+    """HZVerifier emits UNSAT/SAT/UNKNOWN; normalize to verdict vocabulary."""
+    return {"UNSAT": "CERTIFIED", "SAT": "FALSIFIED"}.get(status_str, status_str)
