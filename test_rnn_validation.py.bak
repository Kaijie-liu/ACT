def test_embedding():
    """Test Embedding layer."""
    print("\n[TEST] Embedding")

    num_embeddings = 10
    embedding_dim = 4
    seq_len = 3

    # Create PyTorch Embedding
    embedding = nn.Embedding(num_embeddings, embedding_dim)

    # Create ACT layer
    input_shape = (1, seq_len)
    output_shape = (1, seq_len, embedding_dim)

    layer = Layer(
        kind=LayerKind.EMBEDDING,
        in_vars=list(range(seq_len)),
        out_vars=list(range(seq_len, seq_len + seq_len * embedding_dim)),
        params={'weight': embedding.weight.data},
        meta={
            'num_embeddings': num_embeddings,
            'embedding_dim': embedding_dim,
            'input_shape': input_shape,
            'output_shape': output_shape
        }
    )

    # For embedding, input is indices - use dummy bounds
    input_bounds = Bounds(torch.zeros(seq_len), torch.ones(seq_len) * (num_embeddings - 1))

    # Apply transfer function
    fact = tf_embedding(layer, input_bounds)

    # Check that bounds cover all possible embeddings
    weight_min = embedding.weight.data.min(dim=0)[0]
    weight_max = embedding.weight.data.max(dim=0)[0]

    # Output should have bounds covering all possible embeddings
    output_bounds = fact.bounds.view(seq_len, embedding_dim)

    # Check each position
    all_ok = True
    for i in range(seq_len):
        pos_lb = output_bounds[i * embedding_dim:(i + 1) * embedding_dim, 0]
        pos_ub = output_bounds[i * embedding_dim:(i + 1) * embedding_dim, 1]

        if not torch.allclose(pos_lb, weight_min, atol=1e-6):
            all_ok = False
            break
        if not torch.allclose(pos_ub, weight_max, atol=1e-6):
            all_ok = False
            break

    if all_ok:
        print(f"  ✓ PASSED: Embedding bounds cover all possible embeddings")
        return True
    else:
        print(f"  ✗ FAILED: Embedding bounds incorrect")
        return False


def test_metadata_validation():
    """Test that missing metadata raises errors."""
    print("\n[TEST] Metadata Validation")

    # Test missing required metadata
    try:
        layer = Layer(
            kind=LayerKind.LSTM,
            in_vars=list(range(6)),
            out_vars=list(range(6, 12)),
            params={
                'weight_ih_l0': torch.randn(8, 2),
                'weight_hh_l0': torch.randn(8, 2)
            },
            meta={
                'input_size': 2,
                'hidden_size': 2,
                # Missing: num_layers, batch_first, bidirectional, input_shape, output_shape
            }
        )

        # This should fail validation
        input_bounds = random_bounds((1, 3, 2))
        tf_lstm(layer, input_bounds)

        print(f"  ✗ FAILED: Should have raised ValueError for missing metadata")
        return False

    except ValueError as e:
        if "missing required metadata" in str(e).lower():
            print(f"  ✓ PASSED: Correctly raises error for missing metadata")
            return True
        else:
            print(f"  ✗ FAILED: Wrong error: {e}")
            return False


def test_weight_validation():
    """Test that missing weights raise errors."""
    print("\n[TEST] Weight Validation")

    try:
        layer = Layer(
            kind=LayerKind.LSTM,
            in_vars=list(range(6)),
            out_vars=list(range(6, 12)),
            params={
                # Missing weight_ih_l0 and weight_hh_l0
            },
            meta={
                'input_size': 2,
                'hidden_size': 2,
                'num_layers': 1,
                'batch_first': True,
                'bidirectional': False,
                'input_shape': (1, 3, 2),
                'output_shape': (1, 3, 2)
            }
        )

        input_bounds = random_bounds((1, 3, 2))
        tf_lstm(layer, input_bounds)

        print(f"  ✗ FAILED: Should have raised ValueError for missing weights")
        return False

    except ValueError as e:
        if "missing required parameter" in str(e).lower():
            print(f"  ✓ PASSED: Correctly raises error for missing weights")
            return True
        else:
            print(f"  ✗ FAILED: Wrong error: {e}")
            return False


# =============================================================================
# Main Test Runner
# =============================================================================

def main():
    """Run all tests."""
    print("=" * 70)
    print("RNN/GRU/LSTM/Embedding Validation Test Suite")
    print("=" * 70)

    tests = [
        test_lstm_single_layer_unidirectional,
        test_lstm_multi_layer,
        test_lstm_bidirectional,
        test_gru_single_layer,
        test_rnn_single_layer_tanh,
        test_rnn_single_layer_relu,
        test_embedding,
        test_metadata_validation,
        test_weight_validation,
    ]

    results = []
    for test in tests:
        try:
            passed = test()
            results.append(passed)
        except Exception as e:
            print(f"  ✗ EXCEPTION: {e}")
            import traceback
            traceback.print_exc()
            results.append(False)

    # Summary
    print("\n" + "=" * 70)
    print(f"Test Results: {sum(results)}/{len(results)} passed")
    print("=" * 70)

    if all(results):
        print("\n✓ All tests passed!")
        return 0
    else:
        print(f"\n✗ {len(results) - sum(results)} test(s) failed")
        return 1


if __name__ == "__main__":
    sys.exit(main())
