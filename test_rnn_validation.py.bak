def test_lstm_bidirectional():
    """Test LSTM: bidirectional."""
    print("\n[TEST] LSTM: Bidirectional")

    B, T, input_size, hidden_size = 1, 3, 2, 2
    batch_first = True

    # Create PyTorch LSTM
    lstm = nn.LSTM(input_size, hidden_size, num_layers=1, batch_first=batch_first, bidirectional=True)

    # Extract weights
    params = extract_rnn_weights(lstm, 'lstm')

    # Create ACT layer
    input_shape = (B, T, input_size)
    output_shape = (B, T, 2 * hidden_size)  # Bidirectional doubles output

    layer = Layer(
        kind=LayerKind.LSTM,
        in_vars=list(range(B * T * input_size)),
        out_vars=list(range(B * T * input_size, B * T * input_size + B * T * 2 * hidden_size)),
        params=params,
        meta={
            'input_size': input_size,
            'hidden_size': hidden_size,
            'num_layers': 1,
            'batch_first': batch_first,
            'bidirectional': True,
            'proj_size': 0,
            'input_shape': input_shape,
            'output_shape': output_shape
        }
    )

    # Generate random input bounds
    input_bounds = random_bounds(input_shape)

    # Check soundness
    is_sound, msg = check_soundness(tf_lstm, layer, input_bounds, lstm, n_samples=100, input_shape=input_shape)

    if is_sound:
        print(f"  ✓ PASSED: {msg}")
        return True
    else:
        print(f"  ✗ FAILED: {msg}")
        return False


