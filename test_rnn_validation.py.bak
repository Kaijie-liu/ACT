#!/usr/bin/env python3
"""
Comprehensive validation tests for RNN/GRU/LSTM/Embedding layers.

This test suite validates the complete, fallback-free implementation with:
- Single-layer, single-direction
- Multi-layer
- Bidirectional
- LSTM projection
- Random sampling for soundness verification

Usage:
    python test_rnn_validation.py
"""

import torch
import torch.nn as nn
import numpy as np
from typing import Tuple, List
import sys
from pathlib import Path

# Add ACT to path
act_path = Path(__file__).parent / "act"
sys.path.insert(0, str(act_path))

from act.back_end.core import Layer, Bounds, Net
from act.back_end.layer_schema import LayerKind
from act.back_end.interval_tf.tf_rnn import tf_lstm, tf_gru, tf_rnn, tf_embedding


# =============================================================================
# Test Utilities
# =============================================================================

def random_bounds(shape: Tuple[int, ...], lb_range=(-1, 0), ub_range=(0, 1)) -> Bounds:
    """Generate random interval bounds."""
    size = np.prod(shape)
    lb = torch.rand(size) * (lb_range[1] - lb_range[0]) + lb_range[0]
    ub = torch.rand(size) * (ub_range[1] - ub_range[0]) + ub_range[0]
    return Bounds(lb, ub)


def sample_from_bounds(bounds: Bounds, n_samples: int = 100) -> torch.Tensor:
    """Sample random points from interval bounds."""
    samples = []
    for _ in range(n_samples):
        # Uniform random sample between lb and ub
        alpha = torch.rand_like(bounds.lb)
        sample = bounds.lb + alpha * (bounds.ub - bounds.lb)
        samples.append(sample)
    return torch.stack(samples)


def check_soundness(
    layer_fn,
    layer: Layer,
    input_bounds: Bounds,
    pytorch_module: nn.Module,
    n_samples: int = 100,
    input_shape: Tuple[int, ...] = None
) -> Tuple[bool, str]:
    """
    Check if interval bounds are sound by random sampling.

    Returns:
        (is_sound, error_message)
    """
    # Apply interval transfer function
    fact = layer_fn(layer, input_bounds)
    output_bounds = fact.bounds

    # Sample inputs
    input_samples = sample_from_bounds(input_bounds, n_samples)

    # Reshape samples if needed
    if input_shape is not None:
        input_samples_reshaped = input_samples.view(n_samples, *input_shape)
    else:
        input_samples_reshaped = input_samples

    # Run through PyTorch module
    with torch.no_grad():
        pytorch_outputs = []
        for i in range(n_samples):
            out = pytorch_module(input_samples_reshaped[i:i+1])
            pytorch_outputs.append(out.flatten())
        pytorch_outputs = torch.stack(pytorch_outputs)

    # Check if all outputs are within bounds
    lb_violations = (pytorch_outputs < output_bounds.lb.unsqueeze(0)).any(dim=1)
    ub_violations = (pytorch_outputs > output_bounds.ub.unsqueeze(0)).any(dim=1)

    if lb_violations.any() or ub_violations.any():
        n_violations = (lb_violations | ub_violations).sum().item()
        return False, f"{n_violations}/{n_samples} samples violate bounds"

    return True, "All samples within bounds"


def extract_rnn_weights(rnn_module: nn.Module, cell_type: str = 'lstm') -> dict:
    """Extract weights from PyTorch RNN/GRU/LSTM module."""
    params = {}

    num_layers = rnn_module.num_layers
    bidirectional = rnn_module.bidirectional
    num_directions = 2 if bidirectional else 1

    for layer_idx in range(num_layers):
        for direction_idx in range(num_directions):
            suffix = f"_l{layer_idx}"
            if direction_idx == 1:
                suffix += "_reverse"

            # Weight names in PyTorch
            if direction_idx == 0:
                weight_ih = getattr(rnn_module, f'weight_ih_l{layer_idx}')
                weight_hh = getattr(rnn_module, f'weight_hh_l{layer_idx}')
                bias_ih = getattr(rnn_module, f'bias_ih_l{layer_idx}', None)
                bias_hh = getattr(rnn_module, f'bias_hh_l{layer_idx}', None)
            else:
                weight_ih = getattr(rnn_module, f'weight_ih_l{layer_idx}_reverse')
                weight_hh = getattr(rnn_module, f'weight_hh_l{layer_idx}_reverse')
                bias_ih = getattr(rnn_module, f'bias_ih_l{layer_idx}_reverse', None)
                bias_hh = getattr(rnn_module, f'bias_hh_l{layer_idx}_reverse', None)

            params[f'weight_ih{suffix}'] = weight_ih
            params[f'weight_hh{suffix}'] = weight_hh
            if bias_ih is not None:
                params[f'bias_ih{suffix}'] = bias_ih
            if bias_hh is not None:
                params[f'bias_hh{suffix}'] = bias_hh

            # LSTM projection weights
            if cell_type == 'lstm' and hasattr(rnn_module, 'proj_size') and rnn_module.proj_size > 0:
                if direction_idx == 0:
                    weight_hr = getattr(rnn_module, f'weight_hr_l{layer_idx}', None)
                else:
                    weight_hr = getattr(rnn_module, f'weight_hr_l{layer_idx}_reverse', None)
                if weight_hr is not None:
                    params[f'weight_hr{suffix}'] = weight_hr

    return params


# =============================================================================
# Test Cases
# =============================================================================

def test_lstm_single_layer_unidirectional():
    """Test LSTM: single layer, unidirectional."""
    print("\n[TEST] LSTM: Single Layer, Unidirectional")

    B, T, input_size, hidden_size = 1, 3, 2, 2
    batch_first = True

    # Create PyTorch LSTM
    lstm = nn.LSTM(input_size, hidden_size, num_layers=1, batch_first=batch_first, bidirectional=False)

    # Extract weights
    params = extract_rnn_weights(lstm, 'lstm')

    # Create ACT layer
    input_shape = (B, T, input_size)
    output_shape = (B, T, hidden_size)

    layer = Layer(
        id=0,
        kind=LayerKind.LSTM.value,
        in_vars=list(range(B * T * input_size)),
        out_vars=list(range(B * T * input_size, B * T * input_size + B * T * hidden_size)),
        params=params,
        meta={
            'input_size': input_size,
            'hidden_size': hidden_size,
            'num_layers': 1,
            'batch_first': batch_first,
            'bidirectional': False,
            'proj_size': 0,
            'input_shape': input_shape,
            'output_shape': output_shape
        }
    )

    # Generate random input bounds
    input_bounds = random_bounds(input_shape)

    # Check soundness
    is_sound, msg = check_soundness(tf_lstm, layer, input_bounds, lstm, n_samples=100, input_shape=input_shape)

    if is_sound:
        print(f"  ✓ PASSED: {msg}")
        return True
    else:
        print(f"  ✗ FAILED: {msg}")
        return False


