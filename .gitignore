# OOM-rerun forensic backups (large, on-disk only)
audit_results/**/_oom_rerun_backup/

# Per-instance raw verifier output (often duplicated by .result)
audit_results/**/[0-9][0-9][0-9][0-9]__*.raw

# Crash dumps
